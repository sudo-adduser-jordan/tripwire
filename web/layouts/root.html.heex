<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />

    <.live_title default="Tripwire">
      {assigns[:page_title]}
    </.live_title>

    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <%!-- <link phx-track-static rel="stylesheet" href={~p"/assets/js/app.css"} /> --%>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>

    <script>
      const themeKey = "phx:theme";
      const modeKey = "phx:mode";
      const solidKey = "phx:solid";
      const legacyThemes = {
        eve: ["eve-online", "dark"],
        tripwire: ["eve-online", "dark"],
        wanderer: ["eve-online", "dark"],
        system: ["phoenix", "system"],
        light: ["phoenix", "light"],
        native: ["phoenix", "light"],
        dark: ["phoenix", "dark"],
        "native-dark": ["phoenix", "dark"]
      };

      const setTheme = (theme) => {
        localStorage.setItem(themeKey, theme);
        document.documentElement.setAttribute("data-theme", theme);
      };

      const setMode = (mode) => {
        if (mode === "system") {
          localStorage.removeItem(modeKey);
          mode = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        } else {
          localStorage.setItem(modeKey, mode);
        }
        document.documentElement.setAttribute("data-mode", mode);
      };

      const setSolid = (solid) => {
        if (solid) {
          document.documentElement.setAttribute("data-solid", "true");
        } else {
          document.documentElement.removeAttribute("data-solid");
        }
      };

      const storedTheme = localStorage.getItem(themeKey);
      const legacy = legacyThemes[storedTheme];

      if (legacy) {
        setTheme(legacy[0]);
        if (!localStorage.getItem(modeKey)) setMode(legacy[1]);
      } else {
        setTheme(storedTheme || "eve-online");
      }

      setSolid(localStorage.getItem(solidKey) === "true");

      if (!document.documentElement.hasAttribute("data-mode")) {
        setMode(localStorage.getItem(modeKey) || "system");
      }

      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", () => {
          if (!localStorage.getItem(modeKey)) setMode("system");
        });
      window.addEventListener("storage", (e) => {
        if (e.key === themeKey) setTheme(e.newValue || "eve-online");
        if (e.key === modeKey) setMode(e.newValue || "system");
        if (e.key === solidKey) setSolid(e.newValue === "true");
      });
      window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      window.addEventListener("phx:set-mode", (e) => setMode(e.target.dataset.phxMode));
      window.addEventListener("phx:set-solid", (e) => {
        const solid = e.target.checked === true;
        localStorage.setItem(solidKey, solid ? "true" : "false");
        setSolid(solid);
      });
    </script>
    <style>
      /* eveonline.com hero art: the Fractured Skies loop over its still frame */
      .eve-hero {
        position: fixed;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
        background: #010204;
      }

      .eve-hero picture,
      .eve-hero img {
        position: absolute;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
      }

      .eve-hero img {
        z-index: 0;
        object-fit: cover;
        object-position: center top;
      }

      /* Hero loop docked right like the EVE site, blended at its left edge. */
      .eve-hero video {
        z-index: 0;
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        width: min(58vw, 1100px);
        height: 100%;
        object-fit: cover;
        object-position: center top;
        pointer-events: none;
        -webkit-mask-image: linear-gradient(to right, transparent 0, #000 22%);
        mask-image: linear-gradient(to right, transparent 0, #000 22%);
      }

      /* Never expose playback chrome on this decorative loop. */
      .eve-hero video::-webkit-media-controls,
      .eve-hero video::-webkit-media-controls-enclosure,
      .eve-hero video::-webkit-media-controls-panel,
      .eve-hero video::-webkit-media-controls-play-button,
      .eve-hero video::-webkit-media-controls-start-playback-button,
      .eve-hero video::-webkit-media-controls-overlay-play-button {
        display: none !important;
        -webkit-appearance: none;
      }

      .eve-hero-shade {
        z-index: 1;
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to right,
          rgba(1, 2, 4, 0.82) 0,
          rgba(1, 2, 4, 0.62) 45%,
          rgba(1, 2, 4, 0.34) 100%
        );
      }

      @media (max-width: 900px) {
        .eve-hero video {
          display: none;
          top: 0;
          right: 0;
          bottom: auto;
          width: 100%;
          height: auto;
          max-height: 62vh;
          object-fit: contain;
          -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
          mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
        }

        .eve-hero-shade {
          background: linear-gradient(
            to bottom,
            rgba(1, 2, 4, 0.88) 0,
            rgba(1, 2, 4, 0.9) 45%,
            rgba(1, 2, 4, 0.94) 100%
          );
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .eve-hero video {
          display: none;
        }
      }
    </style>
  </head>

  <body class="font-sans antialiased overflow-x-clip">
    <div class="eve-hero" aria-hidden="true">
      <picture>
        <source media="(max-width: 900px)" srcset={~p"/images/FracturedSkies-mobile2.jpg"} />
        <img src={~p"/images/FracturedSkies-bg.jpg"} alt="" />
      </picture>
      <video
        autoplay
        muted
        playsinline
        preload="auto"
        poster={~p"/images/FracturedSkies-bg.jpg"}
        disablepictureinpicture
        disableremoteplayback
      >
        <source src={~p"/images/FracturedSkies-WH.webm"} type="video/webm" />
      </video>
      <div class="eve-hero-shade"></div>
    </div>

    <div class="relative z-10 mx-auto w-full max-w-full overflow-x-clip">
      {@inner_content}
    </div>
  </body>
</html>
