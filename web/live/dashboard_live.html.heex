<link phx-track-static rel="stylesheet" href={~p"/assets/js/dashboard.css"} />
<script defer phx-track-static type="text/javascript" src={~p"/assets/js/dashboard.js"}>
</script>

<RootLayout.app flash={@flash} current_user={@current_user}>
  <div id="settings-shortcut" hidden phx-hook="SettingsShortcut"></div>

  <.navigation_live
    character={@character.name}
    characters={@characters}
    masks={@masks}
    current_user={@current_user}
    settings_open={@settings_open}
    tq_online={@tq_online}
    tq_players={@tq_players}
    selected_system_name={@selected_system_name}
    current_system_name={@current_system_name}
    character_online={@character_online}
    presences={@presences}
    topbar_now={@topbar_now}
    grid_locked={@grid_locked}
    system_search={@system_search}
    system_suggestions={@system_suggestions}
    sso_configured?={@sso_configured?}
    mask={@mask}
    branding={@branding}
    demo?={@demo?}
  />

  <div :if={@demo?} class="px-2 pt-3 sm:px-3">
    <div class="alert alert-warning mx-auto max-w-[88rem] flex-wrap gap-2 py-2 text-sm">
      <span :if={!@sso_configured?}>
        Demo mode — EVE SSO is not configured. Set <kbd class="kbd kbd-sm">EVESSO_CLIENT_ID</kbd>
        and <kbd class="kbd kbd-sm">EVESSO_SECRET_KEY</kbd>
        to enable EVE login.
      </span>
      <span :if={@sso_configured?}>Demo mode — log in with EVE SSO for a personal map.</span>
      <a :if={@sso_configured?} class="btn btn-sm ml-auto p-0" href={~p"/auth/evesso"}>
        <img
          class="h-8 sso-white"
          src="/images/eve-sso-login-white-small.png"
          alt="Log in with EVE SSO"
        />
        <img
          class="h-8 sso-black"
          src="/images/eve-sso-login-black-small.png"
          alt="Log in with EVE SSO"
        />
      </a>
    </div>
  </div>

  <div :if={@claim_admin?} class="px-2 pt-3 sm:px-3">
    <div id="claim-admin-banner" class="alert alert-info flex-wrap gap-2 py-2 text-sm">
      <span>
        No admin is configured. Make {@character.name} the admin to unlock mask administration.
      </span>
      <button type="button" class="btn btn-primary btn-xs ml-auto" phx-click="claim-admin">
        Make admin
      </button>
    </div>
  </div>

  <div
    class="flex w-full max-w-full flex-col gap-2 overflow-x-clip p-2 sm:p-3"
    id="dashboard-paste"
    phx-hook="GlobalPaste"
  >
    <div
      :if={@stale_ids != []}
      id="stale-toast"
      class="toast toast-top toast-end z-50 mt-16"
      aria-live="polite"
    >
      <div class="alert alert-warning w-80 sm:w-96 max-w-80 sm:max-w-96 text-wrap">
        <span>
          {length(@stale_ids)} missing from paste ({Enum.join(@stale_ids, ", ")}). Delete them?
        </span>
        <div class="flex gap-2">
          <button class="btn btn-error btn-xs" phx-click="delete-stale">
            Delete missing
          </button>
          <button class="btn btn-xs" phx-click="dismiss-stale">Keep</button>
        </div>
      </div>
    </div>
    <div
      class="grid-stack grid-stack-loading w-full max-w-full"
      id="grid-stack"
      phx-hook="GridStack"
      data-grid-locked={to_string(@grid_locked)}
    >
      <.settings_live
        :if={@settings_open}
        map_layout={@map_layout}
        show_row_guides={@show_row_guides}
        show_row_counts={@show_row_counts}
        angled_lines={@angled_lines}
        show_jump_lines={@show_jump_lines}
        show_line_glow={@show_line_glow}
        show_node_badges={@show_node_badges}
        line_weight={@line_weight}
        node_spacing={@node_spacing}
        node_roundness={@node_roundness}
        map_scale={@map_scale}
        map_background={@map_background}
        settings_tab={@settings_tab}
        widget_system={@widget_system}
        widget_notes={@widget_notes}
        widget_signatures={@widget_signatures}
        widget_map={@widget_map}
        layouts={@layouts}
        active_layout={@active_layout}
        layout_errors={@layout_errors}
        characters={@characters}
        masks={@masks}
        admin_masks={@admin_masks}
        character={@character}
        mask={@mask}
        sso_configured?={@sso_configured?}
        presences={@presences}
        current_user={@current_user}
        demo?={@demo?}
        mask_members={demo_mask_members(assigns)}
        stats={demo_character_stats(assigns)}
      />
      <.live_component
        :if={@widget_system}
        module={TripwireWeb.LiveComponents.SystemLive}
        id="system-live"
        map_id={@map && @map.id}
        systems={@systems}
        connections={@connections}
        selected_system_id={@selected_system_id}
        chart_system={@chart_system}
        system_info={@system_info}
        chart_range={@chart_range}
        chart_hidden={@chart_hidden}
        chart_data={@chart_data}
        position={@widget_positions["system"]}
      />
      <.live_component
        :if={@widget_notes}
        module={TripwireWeb.LiveComponents.NotesLive}
        id="notes-live"
        selected_system_id={@selected_system_id}
        selected_system_name={@selected_system_name}
        comments={@comments}
        character={@character}
        demo?={@demo?}
        position={@widget_positions["notes"]}
      />
      <.live_component
        :if={@widget_signatures}
        module={TripwireWeb.LiveComponents.SignaturesLive}
        id="signatures"
        selected_system_id={@selected_system_id}
        selected_system_name={@selected_system_name}
        signatures={@signatures}
        connections={@connections}
        systems={@systems}
        character={@character}
        demo?={@demo?}
        tracking?={Map.get(assigns, :tracking?)}
        position={@widget_positions["signatures"]}
      />
      <.live_component
        :if={@widget_map}
        module={TripwireWeb.LiveComponents.MapLive}
        id="map-live"
        map_id={@map && @map.id}
        map={@map}
        maps={Map.get(assigns, :maps, [])}
        systems={@systems}
        connections={@connections}
        occupants={@occupants}
        selected_system_id={@selected_system_id}
        map_locked={@map_locked}
        collapsed_system_ids={Map.get(@collapsed_by_map, @map && @map.id, MapSet.new())}
        show_row_guides={@show_row_guides}
        show_row_counts={@show_row_counts}
        angled_lines={@angled_lines}
        show_jump_lines={@show_jump_lines}
        show_line_glow={@show_line_glow}
        show_node_badges={@show_node_badges}
        line_weight={@line_weight}
        node_roundness={@node_roundness}
        map_background={@map_background}
        map_scale={@map_scale}
        map_name={if @map, do: @map.name, else: "Demo"}
        demo_state={Map.get(assigns, :demo_state)}
        position={@widget_positions["map"]}
      />
    </div>
  </div>

  <div
    :if={@sys_modal_open}
    id="sys-modal"
    class="modal modal-open"
    phx-hook="DraggableModal"
  >
    <div class="modal-box">
      <h3 class="text-lg font-bold">Edit System</h3>
      <p class="font-mono text-sm opacity-60">
        {sys_modal_title(@systems, @sys_edit_id, @sys_form["solar_system_id"])}
      </p>
      <p :if={@sys_errors != []} class="alert alert-error mt-2 py-2 text-sm">
        {Enum.join(@sys_errors, ", ")}
      </p>
      <form
        phx-submit="update-system"
        phx-change="sys-form-change"
        phx-debounce="200"
        class="mt-3 flex flex-col gap-3"
      >
        <div
          id="sys-name-suggest"
          class="relative"
          phx-hook="SearchSuggest"
          data-suggest-input="#sys-name"
          phx-click-away="sys-suggest-close"
        >
          <label class="form-control">
            <span class="label label-text">System</span>
            <input
              id="sys-name"
              name="system[name]"
              value={@sys_form["name"]}
              placeholder="J150321"
              required
              autocomplete="off"
              class="input input-bordered input-sm w-full font-mono"
            />
          </label>
          <div
            :if={@sys_suggestions != []}
            class="absolute left-0 top-full z-40 mt-1 max-h-64 w-full overflow-y-auto rounded bg-base-200 p-1 text-xs shadow"
          >
            <button
              :for={sug <- @sys_suggestions}
              type="button"
              phx-click="sys-name-pick"
              phx-value-name={sug.name}
              title={"Use #{sug.name}"}
              data-suggest-item
              class="flex w-full items-center gap-2 rounded px-2 py-1 text-left hover:bg-base-300"
            >
              <span
                class="inline-block size-2.5 shrink-0 rounded-full"
                style={"background-color: #{Tripwire.Systems.color(sug)}"}
              >
              </span>
              <span class="truncate font-mono">{sug.name}</span>
              <.effect_icon :if={sug.effect} effect={sug.effect} class="size-3.5 shrink-0" />
            </button>
          </div>
        </div>
        <label class="form-control">
          <span class="label label-text">Alias</span>
          <input
            name="system[alias]"
            value={@sys_form["alias"]}
            placeholder="Blank shows the J-code"
            autocomplete="off"
            class="input input-bordered input-sm w-full"
          />
        </label>
        <label class="form-control">
          <span class="label label-text">Class</span>
          <select name="system[sys_class]" class="select select-bordered select-sm w-full">
            <option value="" selected={@sys_form["sys_class"] in [nil, ""]}>
              Auto (from security)
            </option>
            <option
              :for={opt <- Tripwire.Systems.classes()}
              value={opt}
              selected={@sys_form["sys_class"] == opt}
            >
              {opt}
            </option>
          </select>
        </label>
        <div class="rounded-box bg-base-200 px-3 py-2 text-xs">
          <div class="flex items-baseline justify-between gap-3">
            <span class="label-text">Effect</span>
            <span class="flex min-w-0 items-center gap-1.5 font-mono opacity-60">
              <.effect_icon
                :if={@sys_form["effect"]}
                effect={@sys_form["effect"]}
                class="size-4 shrink-0"
              />
              <span class="truncate">{@sys_form["effect"] || "None"}</span>
            </span>
          </div>
          <div class="flex items-baseline justify-between gap-3">
            <span class="label-text">Statics</span>
            <span class="truncate font-mono opacity-60">{@sys_form["statics"] || "None"}</span>
          </div>
          <p class="mt-1 text-right text-xs opacity-50">Set by the system</p>
        </div>
        <label class="label cursor-pointer justify-start gap-2">
          <input
            type="checkbox"
            name="system[favorite]"
            value="true"
            checked={@sys_form["favorite"]}
            class="toggle toggle-primary toggle-sm"
          />
          <span class="label-text">Favorite</span>
        </label>
        <div class="modal-action justify-between">
          <button
            type="button"
            class="btn btn-error btn-sm"
            phx-click="delete-system"
            data-confirm="Remove this system from the map?"
          >
            Delete
          </button>
          <div class="flex gap-2">
            <button type="button" class="btn btn-sm" phx-click="close-sys-modal">Cancel</button>
            <button type="submit" class="btn btn-primary btn-sm">Save</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <div :if={@sig_modal_open} id="sig-modal" class="modal modal-open" phx-hook="DraggableModal">
    <div class="modal-box">
      <h3 class="text-lg font-bold">
        {if @sig_edit_id, do: "Edit Signature", else: "Add Signature"}
      </h3>
      <p :if={@sig_errors != []} class="alert alert-error mt-2 py-2 text-sm">
        {Enum.join(@sig_errors, ", ")}
      </p>
      <form phx-submit="save-signature" class="mt-3 flex flex-col gap-3">
        <label class="form-control">
          <span class="label label-text">Signature ID</span>
          <input
            name="sig[sig_id]"
            value={@sig_form["sig_id"]}
            placeholder="ABC-123"
            pattern="[A-Za-z]{3}-[0-9]{3}"
            required
            autofocus
            autocomplete="off"
            class="input input-bordered input-sm w-full font-mono uppercase"
          />
        </label>
        <label class="form-control">
          <span class="label label-text">Group</span>
          <select name="sig[kind]" class="select select-bordered select-sm w-full">
            <option value="signature" selected={@sig_form["kind"] == "signature"}>
              Signature
            </option>
            <option value="anomaly" selected={@sig_form["kind"] == "anomaly"}>Anomaly</option>
          </select>
        </label>
        <label class="form-control">
          <span class="label label-text">Site type</span>
          <select name="sig[site_type]" class="select select-bordered select-sm w-full">
            <option
              :for={opt <- ~w(unknown combat data relic ore gas wormhole)}
              value={opt}
              selected={@sig_form["site_type"] == opt}
            >
              {opt}
            </option>
          </select>
        </label>
        <label class="form-control">
          <span class="label label-text">Name / wormhole type</span>
          <input
            name="sig[type_name]"
            value={@sig_form["type_name"]}
            placeholder="Unstable Wormhole (K162) or site name"
            autocomplete="off"
            class="input input-bordered input-sm w-full"
          />
        </label>
        <label class="form-control">
          <span class="label label-text">Lifetime</span>
          <select name="sig[life_length]" class="select select-bordered select-sm w-full">
            <option
              :for={{label, value} <- life_options()}
              value={value}
              selected={to_string(@sig_form["life_length"]) == to_string(value)}
            >
              {label}
            </option>
          </select>
        </label>
        <label class="form-control">
          <span class="label label-text">Type ID</span>
          <input
            name="sig[type_id]"
            value={@sig_form["type_id"]}
            type="number"
            min="1"
            step="1"
            placeholder="Optional ESI type"
            autocomplete="off"
            class="input input-bordered input-sm w-full"
          />
        </label>
        <label class="form-control">
          <span class="label label-text">Scanned at</span>
          <input
            name="sig[scanned_at]"
            value={@sig_form["scanned_at"]}
            type="datetime-local"
            autocomplete="off"
            class="input input-bordered input-sm w-full"
          />
          <span class="mt-1 text-xs opacity-60">Blank uses now.</span>
        </label>
        <label class="form-control">
          <span class="label label-text">Bookmark</span>
          <input
            name="sig[bookmark]"
            value={@sig_form["bookmark"]}
            placeholder="Optional bookmark label"
            autocomplete="off"
            class="input input-bordered input-sm w-full"
          />
        </label>
        <div class="modal-action">
          <button type="button" class="btn btn-sm" phx-click="close-sig-modal">
            Cancel
          </button>
          <button type="submit" class="btn btn-primary btn-sm">
            {if @sig_edit_id, do: "Save", else: "Add"}
          </button>
        </div>
      </form>
    </div>
  </div>

  <div :if={@map_modal_open} id="map-modal" class="modal modal-open" phx-hook="DraggableModal">
    <div class="modal-box">
      <h3 class="text-lg font-bold">Edit Map</h3>
      <p :if={@map_errors != []} class="alert alert-error mt-2 py-2 text-sm">
        {Enum.join(@map_errors, ", ")}
      </p>
      <form phx-submit="save-map-settings" class="mt-3 flex flex-col gap-3">
        <label class="form-control">
          <span class="label label-text">Map name</span>
          <input
            name="map[name]"
            value={@map_form["name"]}
            placeholder="Chain"
            autocomplete="off"
            class="input input-bordered input-sm w-full"
          />
        </label>
        <label class="form-control">
          <span class="label label-text">Home system</span>
          <input
            name="map[home]"
            value={@map_form["home"]}
            placeholder="Jita or 30000142"
            autocomplete="off"
            class="input input-bordered input-sm w-full"
          />
        </label>
        <label class="label cursor-pointer justify-start gap-2">
          <input
            type="checkbox"
            name="map[include_thera]"
            value="true"
            checked={@map_form["include_thera"]}
            class="checkbox checkbox-sm"
          />
          <span class="label-text">Include Thera chain</span>
        </label>
        <div class="flex flex-col gap-1">
          <label class="label cursor-pointer justify-start gap-2">
            <input
              type="checkbox"
              name="map[show_all]"
              value="true"
              checked={@map_form["show_all"]}
              class="checkbox checkbox-sm"
            />
            <span class="label-text">Known space</span>
          </label>
          <p class="pl-7 text-xs opacity-60">
            Everything scanned into this map, including a system that is missing from the
            database because a tracked character is in it.
          </p>
        </div>
        <div class="modal-action justify-between">
          <button
            :if={@map}
            type="button"
            id="delete-map"
            class="btn btn-error btn-sm"
            data-confirm={"Delete #{@map.name} and all of its systems?"}
            phx-click="delete-map"
            phx-value-id={@map.id}
          >
            Delete map
          </button>
          <div class="flex items-center gap-2">
            <button type="button" class="btn btn-sm" phx-click="close-map-modal">
              Cancel
            </button>
            <button type="submit" class="btn btn-primary btn-sm">Save</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <div :if={@claim_admin_modal?} id="claim-admin-modal" class="modal modal-open">
    <div class="modal-box">
      <h3 class="text-lg font-bold">No admin configured</h3>
      <p class="mt-2 text-sm">
        Make {@character.name} the admin to unlock mask administration? You can also decide later.
      </p>
      <div class="modal-action justify-between">
        <button type="button" class="btn btn-sm" phx-click="defer-claim-admin">Later</button>
        <button type="button" class="btn btn-primary btn-sm" phx-click="claim-admin">
          Make admin
        </button>
      </div>
    </div>
    <div class="modal-backdrop">
      <button type="button" phx-click="defer-claim-admin">Close</button>
    </div>
  </div>
</RootLayout.app>
