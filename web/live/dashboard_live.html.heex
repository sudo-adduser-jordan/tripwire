<link phx-track-static rel="stylesheet" href={~p"/assets/js/dashboard.css"} />
<script defer phx-track-static type="text/javascript" src={~p"/assets/js/dashboard.js"}>
</script>

<RootLayout.app flash={@flash} current_user={@current_user}>
  <div id="settings-shortcut" hidden phx-hook="SettingsShortcut"></div>

  <.navigation_live
    character={@character.name}
    characters={@characters}
    masks={@masks}
    current_user={@current_user}
    settings_open={@settings_open}
    tq_online={@tq_online}
    tq_players={@tq_players}
    selected_system_name={@selected_system_name}
    current_system_name={@current_system_name}
    character_online={@character_online}
    presences={@presences}
    topbar_now={@topbar_now}
    grid_locked={@grid_locked}
    system_search={@system_search}
    system_suggestions={@system_suggestions}
    sso_configured?={@sso_configured?}
    mask={@mask}
    branding={@branding}
    demo?={@demo?}
  />

  <div :if={@demo?} class="px-2 pt-3 sm:px-3">
    <div class="alert alert-warning mx-auto max-w-[88rem] flex-wrap gap-2 py-2 text-sm">
      <span :if={!@sso_configured?}>
        Demo mode — EVE SSO is not configured. Set <kbd class="kbd kbd-sm">EVESSO_CLIENT_ID</kbd>
        and <kbd class="kbd kbd-sm">EVESSO_SECRET_KEY</kbd>
        to enable EVE login.
      </span>
      <span :if={@sso_configured?}>Demo mode — log in with EVE SSO for a personal map.</span>
      <a :if={@sso_configured?} class="btn btn-sm ml-auto p-0" href={~p"/auth/evesso"}>
        <img
          class="h-8 sso-white"
          src="/images/eve-sso-login-white-small.png"
          alt="Log in with EVE SSO"
        />
        <img
          class="h-8 sso-black"
          src="/images/eve-sso-login-black-small.png"
          alt="Log in with EVE SSO"
        />
      </a>
    </div>
  </div>

  <div :if={@claim_admin?} class="px-2 pt-3 sm:px-3">
    <div id="claim-admin-banner" class="alert alert-info flex-wrap gap-2 py-2 text-sm">
      <span>
        No admin is configured. Make {@character.name} the admin to unlock mask administration.
      </span>
      <button type="button" class="btn btn-primary btn-xs ml-auto" phx-click="claim-admin">
        Make admin
      </button>
    </div>
  </div>

  <div
    class="flex w-full max-w-full flex-col gap-2 overflow-x-clip p-2 sm:p-3"
    id="dashboard-paste"
    phx-hook="GlobalPaste"
  >
    <div
      :if={@stale_ids != []}
      id="stale-toast"
      class="toast toast-top toast-end z-50 mt-16"
      aria-live="polite"
    >
      <div class="alert alert-warning w-80 sm:w-96 max-w-80 sm:max-w-96 text-wrap">
        <span>
          {length(@stale_ids)} missing from paste ({Enum.join(@stale_ids, ", ")}). Delete them?
        </span>
        <div class="flex gap-2">
          <button class="btn btn-error btn-xs" phx-click="delete-stale">
            Delete missing
          </button>
          <button class="btn btn-xs" phx-click="dismiss-stale">Keep</button>
        </div>
      </div>
    </div>
    <div
      class="grid-stack grid-stack-loading w-full max-w-full"
      id="grid-stack"
      phx-hook="GridStack"
      data-grid-locked={to_string(@grid_locked)}
    >
      <.settings_live
        :if={@settings_open}
        map_layout={@map_layout}
        show_row_guides={@show_row_guides}
        show_row_counts={@show_row_counts}
        angled_lines={@angled_lines}
        show_jump_lines={@show_jump_lines}
        show_line_glow={@show_line_glow}
        show_node_badges={@show_node_badges}
        line_weight={@line_weight}
        node_spacing={@node_spacing}
        node_roundness={@node_roundness}
        map_scale={@map_scale}
        map_background={@map_background}
        settings_tab={@settings_tab}
        widget_system={@widget_system}
        widget_notes={@widget_notes}
        widget_signatures={@widget_signatures}
        widget_map={@widget_map}
        layouts={@layouts}
        active_layout={@active_layout}
        layout_errors={@layout_errors}
        characters={@characters}
        masks={@masks}
        admin_masks={@admin_masks}
        character={@character}
        mask={@mask}
        sso_configured?={@sso_configured?}
        presences={@presences}
        current_user={@current_user}
        demo?={@demo?}
        mask_members={demo_mask_members(assigns)}
        stats={demo_character_stats(assigns)}
      />
      <.live_component
        :if={@widget_system}
        module={ZtripwireWeb.LiveComponents.SystemLive}
        id="system-live"
        map_id={@map && @map.id}
        systems={@systems}
        connections={@connections}
        selected_system_id={@selected_system_id}
        chart_system={@chart_system}
        system_info={@system_info}
        chart_range={@chart_range}
        chart_hidden={@chart_hidden}
        chart_data={@chart_data}
        position={@widget_positions["system"]}
      />
      <.live_component
        :if={@widget_notes}
        module={ZtripwireWeb.LiveComponents.NotesLive}
        id="notes-live"
        selected_system_id={@selected_system_id}
        selected_system_name={@selected_system_name}
        comments={@comments}
        character={@character}
        demo?={@demo?}
        position={@widget_positions["notes"]}
      />
      <.live_component
        :if={@widget_signatures}
        module={ZtripwireWeb.LiveComponents.SignaturesLive}
        id="signatures"
        selected_system_id={@selected_system_id}
        selected_system_name={@selected_system_name}
        signatures={@signatures}
        connections={@connections}
        systems={@systems}
        character={@character}
        demo?={@demo?}
        tracking?={Map.get(assigns, :tracking?)}
        position={@widget_positions["signatures"]}
      />
      <.live_component
        :if={@widget_map}
        module={ZtripwireWeb.LiveComponents.MapLive}
        id="map-live"
        map_id={@map && @map.id}
        map={@map}
        maps={Map.get(assigns, :maps, [])}
        systems={@systems}
        connections={@connections}
        occupants={@occupants}
        selected_system_id={@selected_system_id}
        map_locked={@map_locked}
        collapsed_system_ids={Map.get(@collapsed_by_map, @map && @map.id, MapSet.new())}
        show_row_guides={@show_row_guides}
        show_row_counts={@show_row_counts}
        angled_lines={@angled_lines}
        show_jump_lines={@show_jump_lines}
        show_line_glow={@show_line_glow}
        show_node_badges={@show_node_badges}
        line_weight={@line_weight}
        node_roundness={@node_roundness}
        map_background={@map_background}
        map_scale={@map_scale}
        map_name={if @map, do: @map.name, else: "Demo"}
        demo_state={Map.get(assigns, :demo_state)}
        position={@widget_positions["map"]}
      />
    </div>
  </div>

  <div :if={@sig_modal_open} id="sig-modal" class="modal modal-open" phx-hook="DraggableModal">
    <div class="modal-box max-w-2xl">
      <div class="flex items-start justify-between gap-3">
        <h3 class="text-lg font-bold">
          {if @sig_edit_id, do: "Edit Signature", else: "Add Signature"}
        </h3>
        <button
          type="button"
          class="btn btn-ghost btn-sm btn-circle"
          phx-click="close-sig-modal"
          aria-label="Close"
        >
          ✕
        </button>
      </div>
      <p :if={@sig_errors != []} class="alert alert-error mt-2 py-2 text-sm">
        {Enum.join(@sig_errors, ", ")}
      </p>
      <form
        phx-submit="save-signature"
        phx-change="sig-form-change"
        phx-debounce="200"
        class="mt-3"
      >
        <div class="flex gap-3">
          <span class="hidden shrink-0 rotate-180 items-center justify-center text-xs uppercase tracking-widest opacity-60 [writing-mode:vertical-rl] md:flex">
            {@selected_system_name || "This"} Side
          </span>
          <div class="flex min-w-0 flex-1 flex-col gap-2">
            <div class="flex flex-wrap items-center gap-2">
              <span class="label label-text w-14 justify-end">ID:</span>
              <input
                name="sig[prefix]"
                value={@sig_form["prefix"]}
                maxlength="3"
                pattern="[A-Za-z]{3}"
                title="Three letters"
                required
                autofocus
                autocomplete="off"
                class="input input-bordered input-sm w-16 font-mono uppercase text-center"
              />
              <span class="font-mono opacity-60">-</span>
              <input
                name="sig[number]"
                value={@sig_form["number"]}
                maxlength="3"
                pattern="[0-9]{3}"
                title="Three digits"
                required
                autocomplete="off"
                class="input input-bordered input-sm w-16 font-mono text-center"
              />
              <select name="sig[kind]" class="select select-bordered select-sm">
                <option value="signature" selected={@sig_form["kind"] == "signature"}>
                  Signature
                </option>
                <option value="anomaly" selected={@sig_form["kind"] == "anomaly"}>Anomaly</option>
              </select>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <span class="label label-text w-14 justify-end">Length:</span>
              <input
                name="sig[days]"
                value={@sig_form["days"]}
                type="number"
                min="0"
                max="30"
                class="input input-bordered input-sm w-16 text-center"
              />
              <span class="text-xs opacity-60">days</span>
              <input
                name="sig[hours]"
                value={@sig_form["hours"]}
                type="number"
                min="0"
                max="23"
                class="input input-bordered input-sm w-16 text-center"
              />
              <span class="text-xs opacity-60">hours</span>
              <input
                name="sig[minutes]"
                value={@sig_form["minutes"]}
                type="number"
                min="0"
                max="59"
                class="input input-bordered input-sm w-16 text-center"
              />
              <span class="text-xs opacity-60">minutes</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="label label-text w-14 justify-end">Type:</span>
              <select
                name="sig[site_type]"
                class="select select-bordered select-sm min-w-0 flex-1"
              >
                <option
                  :for={opt <- ~w(unknown combat data relic ore gas wormhole)}
                  value={opt}
                  selected={@sig_form["site_type"] == opt}
                >
                  {opt}
                </option>
              </select>
            </div>
            <div class="flex items-center gap-2">
              <span class="label label-text w-14 justify-end">Leads:</span>
              <select
                name="sig[leads_system_id]"
                class="select select-bordered select-sm min-w-0 flex-1"
              >
                <option value="">—</option>
                <option
                  :for={
                    sys <-
                      @systems
                      |> Enum.reject(&(&1.id == @selected_system_id))
                      |> Enum.sort_by(&(&1.name || "~"))
                  }
                  value={sys.id}
                  selected={@sig_form["leads_system_id"] == to_string(sys.id)}
                >
                  {if sys.name in [nil, ""], do: "Unmapped", else: sys.name}
                </option>
              </select>
            </div>
            <div class="flex items-center gap-2">
              <span class="label label-text w-14 justify-end">Name:</span>
              <input
                name="sig[type_name]"
                value={@sig_form["type_name"]}
                placeholder="Unstable Wormhole (K162) or site name"
                autocomplete="off"
                class="input input-bordered input-sm min-w-0 flex-1"
              />
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <span class="label label-text w-14 justify-end">Life:</span>
              <select name="sig[life_status]" class="select select-bordered select-sm">
                <option value="stable" selected={@sig_form["life_status"] == "stable"}>
                  Stable
                </option>
                <option value="eol" selected={@sig_form["life_status"] == "eol"}>EOL</option>
                <option value="critical" selected={@sig_form["life_status"] == "critical"}>
                  Critical
                </option>
              </select>
              <span class="label label-text justify-end">Mass:</span>
              <select name="sig[mass_status]" class="select select-bordered select-sm">
                <option value="stable" selected={@sig_form["mass_status"] == "stable"}>
                  Stable
                </option>
                <option value="destab" selected={@sig_form["mass_status"] == "destab"}>
                  Destab
                </option>
                <option value="critical" selected={@sig_form["mass_status"] == "critical"}>
                  Critical
                </option>
              </select>
            </div>
          </div>
        </div>

        <div class="divider my-2"></div>

        <div class="flex gap-3">
          <span class="hidden shrink-0 rotate-180 items-center justify-center text-xs uppercase tracking-widest opacity-60 [writing-mode:vertical-rl] md:flex">
            Other Side
          </span>
          <div class="flex min-w-0 flex-1 flex-col gap-2">
            <div class="flex flex-wrap items-center gap-2">
              <span class="label label-text w-14 justify-end">ID:</span>
              <input
                name="sig[other_prefix]"
                value={@sig_form["other_prefix"]}
                maxlength="3"
                pattern="[A-Za-z]{3}"
                placeholder="???"
                autocomplete="off"
                class="input input-bordered input-sm w-16 font-mono uppercase text-center"
              />
              <span class="font-mono opacity-60">-</span>
              <input
                name="sig[other_number]"
                value={@sig_form["other_number"]}
                maxlength="3"
                pattern="[0-9]{3}"
                placeholder="###"
                autocomplete="off"
                class="input input-bordered input-sm w-16 font-mono text-center"
              />
            </div>
            <div class="flex items-center gap-2">
              <span class="label label-text w-14 justify-end">Type:</span>
              <select
                name="sig[other_site_type]"
                class="select select-bordered select-sm min-w-0 flex-1"
              >
                <option
                  :for={opt <- ~w(unknown combat data relic ore gas wormhole)}
                  value={opt}
                  selected={@sig_form["other_site_type"] == opt}
                >
                  {opt}
                </option>
              </select>
            </div>
            <div class="flex items-center gap-2">
              <span class="label label-text w-14 justify-end">Name:</span>
              <input
                name="sig[other_name]"
                value={@sig_form["other_name"]}
                placeholder="Unstable Wormhole (K162) or site name"
                autocomplete="off"
                class="input input-bordered input-sm min-w-0 flex-1"
              />
            </div>
          </div>
        </div>

        <input type="hidden" name="sig[type_id]" value={@sig_form["type_id"]} />
        <input type="hidden" name="sig[bookmark]" value={@sig_form["bookmark"]} />
        <div class="modal-action justify-between">
          <button
            :if={@sig_edit_id}
            type="button"
            class="btn btn-error btn-sm"
            phx-click="delete-signature"
            phx-value-id={@sig_edit_id}
            data-confirm="Delete this signature and its pair?"
          >
            Delete
          </button>
          <div class="ml-auto flex gap-2">
            <button type="submit" class="btn btn-primary btn-sm">
              {if @sig_edit_id, do: "Save", else: "Add"}
            </button>
            <button type="button" class="btn btn-sm" phx-click="close-sig-modal">Cancel</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <div :if={@map_modal_open} id="map-modal" class="modal modal-open" phx-hook="DraggableModal">
    <div class="modal-box">
      <h3 class="text-lg font-bold">Edit Map</h3>
      <p :if={@map_errors != []} class="alert alert-error mt-2 py-2 text-sm">
        {Enum.join(@map_errors, ", ")}
      </p>
      <form phx-submit="save-map-settings" class="mt-3 flex flex-col gap-3">
        <label class="form-control">
          <span class="label label-text">Map name</span>
          <input
            name="map[name]"
            value={@map_form["name"]}
            placeholder="Chain"
            autocomplete="off"
            class="input input-bordered input-sm w-full"
          />
        </label>
        <label class="form-control">
          <span class="label label-text">Home system</span>
          <input
            name="map[home]"
            value={@map_form["home"]}
            placeholder="Jita or 30000142"
            autocomplete="off"
            class="input input-bordered input-sm w-full"
          />
        </label>
        <label class="label cursor-pointer justify-start gap-2">
          <input
            type="checkbox"
            name="map[include_thera]"
            value="true"
            checked={@map_form["include_thera"]}
            class="checkbox checkbox-sm"
          />
          <span class="label-text">Include Thera chain</span>
        </label>
        <div class="flex flex-col gap-1">
          <label class="label cursor-pointer justify-start gap-2">
            <input
              type="checkbox"
              name="map[show_all]"
              value="true"
              checked={@map_form["show_all"]}
              class="checkbox checkbox-sm"
            />
            <span class="label-text">Known space</span>
          </label>
          <p class="pl-7 text-xs opacity-60">
            Everything scanned into this map, including a system that is missing from the
            database because a tracked character is in it.
          </p>
        </div>
        <div class="modal-action justify-between">
          <button
            :if={@map}
            type="button"
            id="delete-map"
            class="btn btn-error btn-sm"
            data-confirm={"Delete #{@map.name} and all of its systems?"}
            phx-click="delete-map"
            phx-value-id={@map.id}
          >
            Delete map
          </button>
          <div class="flex items-center gap-2">
            <button type="button" class="btn btn-sm" phx-click="close-map-modal">
              Cancel
            </button>
            <button type="submit" class="btn btn-primary btn-sm">Save</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <div :if={@claim_admin_modal?} id="claim-admin-modal" class="modal modal-open">
    <div class="modal-box">
      <h3 class="text-lg font-bold">No admin configured</h3>
      <p class="mt-2 text-sm">
        Make {@character.name} the admin to unlock mask administration? You can also decide later.
      </p>
      <div class="modal-action justify-between">
        <button type="button" class="btn btn-sm" phx-click="defer-claim-admin">Later</button>
        <button type="button" class="btn btn-primary btn-sm" phx-click="claim-admin">
          Make admin
        </button>
      </div>
    </div>
    <div class="modal-backdrop">
      <button type="button" phx-click="defer-claim-admin">Close</button>
    </div>
  </div>
</RootLayout.app>
