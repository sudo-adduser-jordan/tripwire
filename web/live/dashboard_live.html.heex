<link phx-track-static rel="stylesheet" href={~p"/assets/js/dashboard.css"} />
<script defer phx-track-static type="text/javascript" src={~p"/assets/js/dashboard.js"}>
</script>

<RootLayout.app flash={@flash} current_user={@current_user}>
  <.navigation user={@nav_user} />

  <div :if={@demo?} class="px-2 sm:px-3">
    <div class="alert alert-warning py-2 text-sm">
      <span>Demo mode — log in with EVE SSO for a personal map.</span>
    </div>
  </div>

  <div class="flex w-full max-w-full flex-col gap-2 overflow-x-clip p-2 sm:p-3">
    <div
      class="grid-stack grid-stack-loading w-full max-w-full"
      id="grid-stack"
      phx-hook="GridStack"
    >
      <.settings :if={@settings_open} map_layout={@map_layout} settings_tab={@settings_tab} />
      <.system systems={@systems} selected_system_id={@selected_system_id} />
      <.notes />
      <.signatures
        id="signatures"
        signatures={@signatures}
        selected_system_id={@selected_system_id}
        paste_open={@paste_open}
        paste_text={@paste_text}
      />
      <.map
        systems={@systems}
        connections={@connections}
        selected_system_id={@selected_system_id}
        map_name={if @map, do: @map.name, else: "Demo"}
      />
    </div>
  </div>
</RootLayout.app>
